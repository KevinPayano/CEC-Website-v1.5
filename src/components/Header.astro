---
import { mainNav, cta } from '../data/navigation';
import { site } from '../data/site';
import Button from './Button.astro';

const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  class="sticky top-0 z-50 border-b border-ink/10 bg-white/95 backdrop-blur-sm"
  x-data="{ open: false }"
  @keydown.escape.window="open = false"
>
  <div class="container-site">
    <div class="flex h-16 items-center justify-between gap-4 md:h-20">
      <a href="/" class="shrink-0" aria-label={`${site.name} home`}>
        <img
          src={site.logo}
          alt={site.name}
          width="220"
          height="56"
          class="h-10 w-auto md:h-12"
        />
      </a>

      <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
        {
          mainNav.map((link) => (
            <a
              href={link.href}
              class:list={[
                'text-[15px] font-semibold transition-colors hover:text-brand',
                isActive(link.href) ? 'text-brand' : 'text-ink',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-4 lg:flex">
        <a
          href={site.phoneHref}
          class="text-[15px] font-semibold text-ink transition-colors hover:text-brand"
        >
          {site.phoneDisplay}
        </a>
        <Button href={cta.primary.href} size="sm">{cta.primary.label}</Button>
      </div>

      <button
        type="button"
        class="inline-flex items-center justify-center rounded p-2 text-ink lg:hidden"
        @click="open = !open"
        :aria-expanded="open.toString()"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg x-show="!open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg x-cloak x-show="open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    x-cloak
    x-show="open"
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 -translate-y-1"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-1"
    class="border-t border-ink/10 bg-white lg:hidden"
  >
    <nav class="container-site flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        mainNav.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded px-3 py-3 text-base font-semibold',
              isActive(link.href) ? 'bg-brand-light text-brand' : 'text-ink hover:bg-surface-muted',
            ]}
            @click="open = false"
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={site.phoneHref}
        class="rounded px-3 py-3 text-base font-semibold text-ink hover:bg-surface-muted"
      >
        {site.phoneDisplay}
      </a>
      <div class="px-3 pt-2">
        <Button href={cta.primary.href} class="w-full">{cta.primary.label}</Button>
      </div>
    </nav>
  </div>
</header>

<style is:global>
  [x-cloak] {
    display: none !important;
  }
</style>
