---
import { footerNav } from '../data/navigation';
import { services } from '../data/services';
import { site } from '../data/site';
---

<footer class="border-t border-white/10 bg-ink text-white">
  <div class="container-site section-pad">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <a href="/" class="inline-block">
          <img
            src="/images/logo-footer.png"
            alt={site.name}
            width="220"
            height="56"
            class="h-12 w-auto invert"
          />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/75">
          Concrete contractors serving homeowners and general contractors across North Carolina.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl tracking-wide text-white">Explore</h2>
        <ul class="mt-4 space-y-2">
          {
            footerNav.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-white/75 transition-colors hover:text-brand">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-display text-2xl tracking-wide text-white">Services</h2>
        <ul class="mt-4 space-y-2">
          {
            services.map((service) => (
              <li>
                <a
                  href={`/services/${service.slug}`}
                  class="text-sm text-white/75 transition-colors hover:text-brand"
                >
                  {service.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-display text-2xl tracking-wide text-white">Contact</h2>
        <ul class="mt-4 space-y-3 text-sm text-white/75">
          <li>
            <a href={site.phoneHref} class="transition-colors hover:text-brand">
              {site.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="break-all transition-colors hover:text-brand">
              {site.email}
            </a>
          </li>
          <li>
            <p>{site.hours.weekdays}</p>
            <p class="mt-1">{site.hours.weekend}</p>
          </li>
          <li>{site.serviceArea}</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-sm text-white/60 md:flex-row md:items-center md:justify-between"
    >
      <p>
        © {new Date().getFullYear()} {site.name}. All rights reserved.
      </p>
      <p>
        Website by{' '}
        <a
          href={site.creatorCredit.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/80 underline-offset-2 hover:text-brand hover:underline"
        >
          {site.creatorCredit.name}
        </a>
      </p>
    </div>
  </div>
</footer>
