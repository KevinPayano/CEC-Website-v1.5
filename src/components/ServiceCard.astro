---
import type { Service } from '../data/services';

interface Props {
  service: Service;
  featured?: boolean;
}

const { service, featured = false } = Astro.props;
---

<article
  class:list={[
    'group flex h-full flex-col overflow-hidden border border-ink/10 bg-white',
    featured && 'md:col-span-2 lg:col-span-1',
  ]}
>
  <a href={`/services/${service.slug}`} class="block overflow-hidden">
    <img
      src={service.image}
      alt={service.imageAlt}
      width="640"
      height="400"
      loading="lazy"
      decoding="async"
      class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </a>
  <div class="flex flex-1 flex-col p-5 md:p-6">
    <h3 class="font-display text-3xl tracking-wide text-ink">
      <a href={`/services/${service.slug}`} class="hover:text-brand">
        {service.name}
      </a>
    </h3>
    <p class="mt-3 flex-1 text-ink-muted leading-relaxed">
      {service.shortDescription}
    </p>
    <a
      href={`/services/${service.slug}`}
      class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand hover:text-brand-dark"
    >
      View service
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
