---
import { cta } from '../data/navigation';
import { site } from '../data/site';
---

<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-ink/10 bg-white p-3 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] md:hidden"
  role="region"
  aria-label="Quick contact actions"
>
  <div class="grid grid-cols-2 gap-2">
    <a
      href={site.phoneHref}
      class="inline-flex items-center justify-center rounded-md bg-ink px-4 py-3 font-sans text-sm font-semibold text-white"
    >
      Call Now
    </a>
    <a
      href={cta.primary.href}
      class="inline-flex items-center justify-center rounded-md bg-brand px-4 py-3 font-sans text-sm font-semibold text-white"
    >
      Get a Quote
    </a>
  </div>
</div>
