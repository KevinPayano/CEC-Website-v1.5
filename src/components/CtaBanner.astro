---
import Button from './Button.astro';
import { cta } from '../data/navigation';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ready to start your concrete project?',
  description = 'Tell us about your driveway, slab, sidewalk, foundation, or patio. We’ll follow up with a clear quote.',
} = Astro.props;
---

<section class="bg-ink">
  <div class="container-site section-pad">
    <div class="grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="font-display text-4xl tracking-wide text-white md:text-5xl">
          {title}
        </h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/80">
          {description}
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
        <Button href={cta.primary.href} variant="primary" size="lg">
          {cta.primary.label}
        </Button>
        <Button href={site.phoneHref} variant="outline" size="lg">
          {site.phoneDisplay}
        </Button>
      </div>
    </div>
  </div>
</section>
