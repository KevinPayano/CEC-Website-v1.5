---
import SectionHeading from '../components/SectionHeading.astro';
import StarRating from '../components/StarRating.astro';
import { testimonials } from '../data/testimonials';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const items = typeof limit === 'number' ? testimonials.slice(0, limit) : testimonials;
const slideCount = items.length;
---

<section id="testimonials" class="bg-white pt-14 md:pt-20">
  <div class="container-site mb-8 md:mb-10">
    <SectionHeading
      align="center"
      class="mx-auto"
      eyebrow="Client feedback"
      title="What homeowners say about the work"
      description="Real comments from people who hired Concrete Experts for patios, slabs, sidewalks, foundations, and more."
    />
  </div>

  <div
    class="relative w-full"
    x-data={`{
      active: 0,
      total: ${slideCount},
      timer: null,
      next() { this.active = (this.active + 1) % this.total },
      prev() { this.active = (this.active - 1 + this.total) % this.total },
      go(i) { this.active = i },
      start() {
        this.stop();
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        this.timer = setInterval(() => this.next(), 7000);
      },
      stop() {
        if (this.timer) clearInterval(this.timer);
      }
    }`}
    x-init="start()"
    @mouseenter="stop()"
    @mouseleave="start()"
    @focusin="stop()"
    @focusout="start()"
    role="region"
    aria-roledescription="carousel"
    aria-label="Customer testimonials"
  >
    <div class="relative h-[70vh] min-h-[28rem] overflow-hidden md:h-[80vh]">
      {
        items.map((testimonial, index) => (
          <article
            class="absolute inset-0"
            x-show={`active === ${index}`}
            x-transition:enter="transition ease-out duration-500"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-300"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            {...(index === 0 ? {} : { 'x-cloak': true, style: 'display: none;' })}
            :aria-hidden={`active !== ${index}`}
          >
            <img
              src={testimonial.image}
              alt={testimonial.imageAlt}
              width="1600"
              height="900"
              class="absolute inset-0 h-full w-full object-cover"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/20" />

            <div class="relative flex h-full items-end">
              <div class="container-site w-full pb-14 md:pb-16">
                <figure class="max-w-3xl">
                  <blockquote>
                    <p class="font-sans text-base leading-relaxed text-white sm:text-lg lg:text-xl">
                      “{testimonial.quote}”
                    </p>
                  </blockquote>
                  <figcaption class="mt-4 flex flex-wrap items-center gap-3">
                    <p class="font-sans font-semibold text-white">{testimonial.author}</p>
                    <span class="hidden h-4 w-px bg-white/40 sm:block" aria-hidden="true" />
                    <StarRating />
                  </figcaption>
                </figure>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <button
      type="button"
      class="absolute left-3 top-1/2 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/30 text-white transition hover:bg-white/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white sm:left-5 sm:h-11 sm:w-11"
      @click="prev()"
      aria-label="Previous testimonial"
    >
      <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <button
      type="button"
      class="absolute right-3 top-1/2 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/30 text-white transition hover:bg-white/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white sm:right-5 sm:h-11 sm:w-11"
      @click="next()"
      aria-label="Next testimonial"
    >
      <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <div
      class="absolute bottom-4 left-1/2 z-20 flex -translate-x-1/2 gap-2"
      role="tablist"
      aria-label="Choose testimonial"
    >
      {
        items.map((_, index) => (
          <button
            type="button"
            class="h-2.5 w-2.5 rounded-full transition"
            :class={`active === ${index} ? 'bg-brand' : 'bg-white/50 hover:bg-white/80'`}
            @click={`go(${index})`}
            :aria-selected={`active === ${index}`}
            aria-label={`Show testimonial ${index + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>
