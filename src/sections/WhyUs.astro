---
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';

const reasons = [
  {
    title: 'Show up and communicate',
    text: 'Customers mention on-time arrivals, returned calls, and clear updates—because a good pour starts with good coordination.',
  },
  {
    title: 'Built for how you use it',
    text: 'Driveways, slabs, sidewalks, foundations, and patios are sized and finished for real use—not just a quick install.',
  },
  {
    title: 'Homeowners and GCs welcome',
    text: 'Whether you’re upgrading a backyard or managing a build schedule, we work to match the scope and keep the job moving.',
  },
  {
    title: 'Finish that holds up',
    text: 'From stamped patios to foundation work, the goal is simple: solid concrete and a result you’re proud to use.',
  },
];
---

<section id="why-us" class="section-pad bg-surface-muted">
  <div class="container-site">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <SectionHeading
          eyebrow="Why choose us"
          title="Quality concrete work with communication you can count on"
          description="With 10+ years of experience, 100+ completed projects, and a 4.9-star Google rating, Concrete Experts Company helps North Carolina homeowners and contractors get dependable concrete installed—without the runaround."
        />
        <div class="mt-8">
          <Button href="/about" variant="ghost">Learn about our team</Button>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {
          reasons.map((reason) => (
            <article class="border border-ink/10 bg-white p-5">
              <h3 class="font-display text-2xl tracking-wide text-ink">{reason.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted md:text-base">{reason.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
