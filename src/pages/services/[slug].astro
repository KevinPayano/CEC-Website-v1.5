---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { services, getServiceBySlug } from '../../data/services';
import { cta } from '../../data/navigation';
import { site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;
const service = getServiceBySlug(slug!);

if (!service) {
  throw new Error(`Unknown service slug: ${slug}`);
}

const related = services.filter((item) => item.slug !== service.slug).slice(0, 3);
---

<BaseLayout
  title={`${service.name} in North Carolina`}
  description={`${service.shortDescription} Request a free quote from Concrete Experts Company.`}
  ogImage={service.image}
>
  <section class="relative isolate overflow-hidden bg-ink">
    <img
      src={service.image}
      alt={service.imageAlt}
      width="1600"
      height="900"
      class="absolute inset-0 h-full w-full object-cover opacity-35"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-ink/80"></div>
    <div class="container-site relative py-16 md:py-24">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.16em] text-brand">
        <a href="/services" class="hover:underline">Services</a>
        <span class="mx-2 text-white/40">/</span>
        {service.name}
      </p>
      <h1 class="max-w-3xl font-display text-5xl tracking-wide text-white md:text-6xl">
        {service.name} in North Carolina
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white/85">
        {service.shortDescription}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href="#service-quote" variant="primary" size="lg">{cta.primary.label}</Button>
        <Button href={site.phoneHref} variant="outline" size="lg">
          Call {site.phoneDisplay}
        </Button>
      </div>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-site grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-14">
      <div>
        <h2 class="font-display text-4xl tracking-wide text-ink">About this service</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-muted">{service.description}</p>

        <h3 class="mt-10 font-display text-3xl tracking-wide text-ink">What you can expect</h3>
        <ul class="mt-4 space-y-3">
          {
            service.benefits.map((benefit) => (
              <li class="flex items-start gap-3 text-ink-muted">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-brand" aria-hidden="true" />
                {benefit}
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="h-fit border border-ink/10 bg-surface-muted p-6 md:p-7">
        <h2 class="font-display text-3xl tracking-wide text-ink">Ideal for</h2>
        <ul class="mt-4 space-y-3">
          {
            service.idealFor.map((item) => (
              <li class="flex items-start gap-3 text-ink-muted">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-brand" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
        <div class="mt-8 space-y-3">
          <Button href="#service-quote" variant="primary" class="w-full">
            {cta.primary.label}
          </Button>
          <Button href={site.phoneHref} variant="ghost" class="w-full">
            {site.phoneDisplay}
          </Button>
        </div>
      </aside>
    </div>
  </section>

  <section id="service-quote" class="section-pad bg-surface-muted">
    <div class="container-site grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <h2 class="font-display text-4xl tracking-wide text-ink">
          Request a quote for {service.name.toLowerCase()}
        </h2>
        <p class="mt-4 text-ink-muted leading-relaxed">
          Include approximate size, property location, and any plans or photos. We’ll follow up
          with next steps.
        </p>
      </div>
      <div class="border border-ink/10 bg-white p-6 md:p-8">
        <QuoteForm id={`${service.slug}-quote-form`} defaultService={service.name} />
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section-pad bg-white">
        <div class="container-site">
          <h2 class="font-display text-4xl tracking-wide text-ink">Related services</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <a
                href={`/services/${item.slug}`}
                class="border border-ink/10 p-5 transition-colors hover:border-brand"
              >
                <h3 class="font-display text-2xl tracking-wide text-ink">{item.name}</h3>
                <p class="mt-2 text-sm text-ink-muted">{item.shortDescription}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBanner />
</BaseLayout>
