---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { site } from '../data/site';
import { cta } from '../data/navigation';
---

<BaseLayout
  title="About Us"
  description="Meet Concrete Experts Company—North Carolina concrete contractors with 10+ years of experience, 100+ projects completed, and a 4.9-star Google rating."
>
  <section class="relative isolate overflow-hidden bg-ink">
    <img
      src="/images/about.jpg"
      alt="Concrete Experts Company workers on a job site"
      width="1600"
      height="900"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-ink/75"></div>
    <div class="container-site relative py-20 md:py-28">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.16em] text-brand">About us</p>
      <h1 class="max-w-3xl font-display text-5xl tracking-wide text-white md:text-6xl">
        A concrete crew that communicates and finishes the job
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white/85">
        Concrete Experts Company has 10+ years of experience serving homeowners and general
        contractors across North Carolina with driveways, slabs, sidewalks, footing foundations,
        and patios.
      </p>
    </div>
  </section>

  <section class="border-b border-ink/10 bg-surface-muted">
    <div class="container-site py-8 md:py-10">
      <dl class="grid gap-6 sm:grid-cols-3">
        {
          site.stats.map((stat) => (
            <div class="text-center sm:text-left">
              <dt class="font-display text-4xl tracking-wide text-brand md:text-5xl">{stat.value}</dt>
              <dd class="mt-1 text-sm font-semibold uppercase tracking-[0.08em] text-ink md:text-[15px]">
                {stat.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-site grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading
          title="Built around clear communication and solid work"
          description="Customers often mention Mike and the team for showing up on time, answering calls, and making sure the finished concrete meets expectations before they leave."
        />
        <p class="mt-6 leading-relaxed text-ink-muted">
          Across 100+ projects, whether you need a stamped patio for weekends outside, a slab for
          equipment, or footings for a new build, we focus on preparation, craftsmanship, and
          staying easy to work with from quote through pour day. Our 4.9-star Google rating
          reflects that approach.
        </p>
      </div>
      <div class="border border-ink/10 bg-surface-muted p-8">
        <h2 class="font-display text-3xl tracking-wide text-ink">Who we work with</h2>
        <ul class="mt-6 space-y-5">
          <li>
            <h3 class="font-semibold text-ink">Homeowners</h3>
            <p class="mt-1 text-ink-muted">
              Driveways, sidewalks, and outdoor living spaces with finishes that match your property.
            </p>
          </li>
          <li>
            <h3 class="font-semibold text-ink">General contractors</h3>
            <p class="mt-1 text-ink-muted">
              Reliable flatwork and foundation concrete that fits build schedules and inspections.
            </p>
          </li>
        </ul>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={cta.primary.href} variant="primary">{cta.primary.label}</Button>
          <Button href={site.phoneHref} variant="ghost">Call {site.phoneDisplay}</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad bg-surface-muted">
    <div class="container-site">
      <SectionHeading
        title="What guides every project"
        description="Simple standards that show up again and again in customer feedback."
      />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          [
            {
              title: 'Communication',
              text: 'Returned calls, clear quotes, and updates so you’re never left guessing.',
            },
            {
              title: 'Craftsmanship',
              text: 'Proper prep and finishes for driveways, slabs, foundations, and patios.',
            },
            {
              title: 'Follow-through',
              text: 'We aim to leave you satisfied with the result before the job is done.',
            },
          ].map((item) => (
            <article class="border border-ink/10 bg-white p-6">
              <h3 class="font-display text-3xl tracking-wide text-ink">{item.title}</h3>
              <p class="mt-3 text-ink-muted leading-relaxed">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner
    title="Have a project in mind?"
    description="Request a quote or call Concrete Experts Company to talk through your concrete work."
  />
</BaseLayout>
